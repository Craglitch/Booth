---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Tentang Kami - IT Career Expo">
  <section class="py-10 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <div class="inline-block bg-green-100 px-3 md:px-4 py-1.5 md:py-2 rounded-full mb-3 md:mb-4">
          <span class="text-green-700 text-xs md:text-sm font-medium">ℹ️ TENTANG KAMI</span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-5xl font-bold text-gray-900">
          Booth <span class="text-green-600">Dukun Data</span>
        </h1>
      </div>

      <div class="bg-white rounded-2xl p-5 md:p-12 shadow-sm border border-gray-100 mb-6 md:mb-8">
        <h2 class="text-xl md:text-2xl font-bold text-gray-900 mb-3 md:mb-4">🎯 Apa Itu Booth Ini?</h2>
        <p class="text-gray-600 leading-relaxed text-sm md:text-base">
          Booth IT Career Expo ini adalah satu inisiatif untuk memberi pendedahan kepada pelajar tentang 
          peluang kerjaya dalam bidang Teknologi Maklumat. Kami percaya bahawa setiap pelajar berhak 
          mengetahui peluang yang ada dalam dunia digital yang semakin berkembang.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 mb-6 md:mb-8">
        <div class="bg-white rounded-2xl p-5 md:p-6 shadow-sm border border-gray-100">
          <div class="text-3xl md:text-4xl mb-2 md:mb-3">🎓</div>
          <h3 class="text-base md:text-lg font-bold text-gray-900">Pendidikan</h3>
          <p class="text-gray-600 text-xs md:text-sm mt-2">Memberi maklumat tepat tentang kerjaya IT.</p>
        </div>

        <div class="bg-white rounded-2xl p-5 md:p-6 shadow-sm border border-gray-100">
          <div class="text-3xl md:text-4xl mb-2 md:mb-3">🌐</div>
          <h3 class="text-base md:text-lg font-bold text-gray-900">Pendedahan</h3>
          <p class="text-gray-600 text-xs md:text-sm mt-2">Menunjukkan pelbagai laluan kerjaya IT.</p>
        </div>

        <div class="bg-white rounded-2xl p-5 md:p-6 shadow-sm border border-gray-100">
          <div class="text-3xl md:text-4xl mb-2 md:mb-3">🚀</div>
          <h3 class="text-base md:text-lg font-bold text-gray-900">Inspirasi</h3>
          <p class="text-gray-600 text-xs md:text-sm mt-2">Membakar semangat pelajar untuk bidang IT.</p>
        </div>
      </div>

      <div class="bg-gradient-to-r from-green-600 to-emerald-600 rounded-2xl p-6 md:p-12 text-white">
        <div class="text-center">
          <div class="text-4xl md:text-5xl mb-3 md:mb-4">🏆</div>
          <h2 class="text-xl md:text-3xl font-bold">Pertandingan Booth</h2>
          <p class="text-green-100 mt-3 md:mt-4 max-w-2xl mx-auto text-sm md:text-base">
            Booth ini dibina untuk pertandingan booth IT peringkat sekolah. 
            Kami berharap dapat berkongsi ilmu dan inspirasi kepada semua pengunjung.
          </p>
        </div>
      </div>

    </div>
  </section>
</Layout>
