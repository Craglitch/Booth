---
import Layout from "../layouts/Layout.astro";

const skillCategories = [
  { icon: "💻", title: "Programming", skills: [{ name: "Python", level: 90 }, { name: "JavaScript", level: 85 }, { name: "Java", level: 80 }, { name: "C++", level: 70 }] },
  { icon: "🌐", title: "Web Development", skills: [{ name: "HTML/CSS", level: 95 }, { name: "React", level: 80 }, { name: "Node.js", level: 75 }, { name: "Tailwind", level: 85 }] },
  { icon: "🔐", title: "Cyber Security", skills: [{ name: "Networking", level: 85 }, { name: "Linux", level: 80 }, { name: "Ethical Hacking", level: 70 }] },
  { icon: "📊", title: "Data & AI", skills: [{ name: "SQL", level: 85 }, { name: "Machine Learning", level: 70 }, { name: "Statistics", level: 75 }] },
];

const softSkills = [
  { icon: "🧠", name: "Problem Solving" },
  { icon: "🤝", name: "Teamwork" },
  { icon: "💬", name: "Communication" },
  { icon: "⏰", name: "Time Management" },
  { icon: "🔄", name: "Adaptability" },
  { icon: "🎯", name: "Critical Thinking" },
  { icon: "📚", name: "Continuous Learning" },
  { icon: "🎨", name: "Creativity" },
];
---

<Layout title="Skill IT - IT Career Expo">
  <section class="py-10 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <div class="inline-block bg-green-100 px-3 md:px-4 py-1.5 md:py-2 rounded-full mb-3 md:mb-4">
          <span class="text-green-700 text-xs md:text-sm font-medium">⚡ SKILL DIPERLUKAN</span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-5xl font-bold text-gray-900">
          Skill Untuk <span class="text-green-600">Kerjaya IT</span>
        </h1>
        <p class="text-gray-600 mt-3 md:mt-4 max-w-2xl mx-auto text-sm md:text-base">
          Untuk berjaya dalam bidang IT, anda perlu menguasai pelbagai skill.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-10 md:mb-16">
        {skillCategories.map((category) => (
          <div class="bg-white rounded-2xl p-5 md:p-8 shadow-sm border border-gray-100 hover:shadow-xl transition-all">
            
            <div class="flex items-center gap-2 md:gap-3 mb-4 md:mb-6">
              <span class="text-3xl md:text-4xl">{category.icon}</span>
              <h2 class="text-xl md:text-2xl font-bold text-gray-900">{category.title}</h2>
            </div>

            <div class="space-y-3 md:space-y-4">
              {category.skills.map((skill) => (
                <div>
                  <div class="flex justify-between mb-1">
                    <span class="text-xs md:text-sm font-medium text-gray-700">{skill.name}</span>
                    <span class="text-xs md:text-sm text-gray-500">{skill.level}%</span>
                  </div>
                  <div class="w-full bg-gray-100 rounded-full h-1.5 md:h-2">
                    <div class="bg-green-500 h-1.5 md:h-2 rounded-full" style={`width: ${skill.level}%`}></div>
                  </div>
                </div>
              ))}
            </div>

          </div>
        ))}
      </div>

      <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-2xl p-6 md:p-12">
        <div class="text-center mb-6 md:mb-8">
          <h2 class="text-2xl md:text-3xl font-bold text-white">Soft Skills</h2>
          <p class="text-gray-300 mt-2 text-sm md:text-base">Kemahiran insaniah yang penting dalam kerjaya IT</p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 md:gap-4">
          {softSkills.map((skill) => (
            <div class="bg-white/10 backdrop-blur-sm rounded-xl p-3 md:p-4 text-center border border-white/10 hover:bg-white/20 transition-all">
              <div class="text-2xl md:text-3xl mb-1 md:mb-2">{skill.icon}</div>
              <div class="text-white text-xs md:text-sm font-medium">{skill.name}</div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>
