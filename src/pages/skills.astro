---
import Layout from "../layouts/Layout.astro";

const skillCategories = [
  {
    icon: "💻",
    title: "Programming",
    color: "blue",
    skills: [
      { name: "Python", level: 90 },
      { name: "JavaScript", level: 85 },
      { name: "Java", level: 80 },
      { name: "C++", level: 70 },
    ],
  },
  {
    icon: "🌐",
    title: "Web Development",
    color: "green",
    skills: [
      { name: "HTML/CSS", level: 95 },
      { name: "React", level: 80 },
      { name: "Node.js", level: 75 },
      { name: "Tailwind", level: 85 },
    ],
  },
  {
    icon: "🔐",
    title: "Cyber Security",
    color: "red",
    skills: [
      { name: "Networking", level: 85 },
      { name: "Linux", level: 80 },
      { name: "Ethical Hacking", level: 70 },
      { name: "Cryptography", level: 65 },
    ],
  },
  {
    icon: "📊",
    title: "Data & AI",
    color: "purple",
    skills: [
      { name: "SQL", level: 85 },
      { name: "Machine Learning", level: 70 },
      { name: "Statistics", level: 75 },
      { name: "Data Viz", level: 80 },
    ],
  },
];

const softSkills = [
  { icon: "🧠", name: "Problem Solving" },
  { icon: "🤝", name: "Teamwork" },
  { icon: "💬", name: "Communication" },
  { icon: "⏰", name: "Time Management" },
  { icon: "🔄", name: "Adaptability" },
  { icon: "🎯", name: "Critical Thinking" },
  { icon: "📚", name: "Continuous Learning" },
  { icon: "🎨", name: "Creativity" },
];
---

<Layout title="Skill IT - IT Career Expo">
  <section class="py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-12">
        <div class="inline-block bg-green-100 px-4 py-2 rounded-full mb-4">
          <span class="text-green-700 text-sm font-medium">⚡ SKILL DIPERLUKAN</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900">
          Skill Untuk <span class="text-green-600">Kerjaya IT</span>
        </h1>
        <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
          Untuk berjaya dalam bidang IT, anda perlu menguasai pelbagai skill teknikal dan soft skills.
        </p>
      </div>

      <!-- Technical Skills -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
        {skillCategories.map((category) => (
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 hover:shadow-xl transition-all">
            
            <div class="flex items-center gap-3 mb-6">
              <span class="text-4xl">{category.icon}</span>
              <h2 class="text-2xl font-bold text-gray-900">{category.title}</h2>
            </div>

            <div class="space-y-4">
              {category.skills.map((skill) => (
                <div>
                  <div class="flex justify-between mb-1">
                    <span class="text-sm font-medium text-gray-700">{skill.name}</span>
                    <span class="text-sm text-gray-500">{skill.level}%</span>
                  </div>
                  <div class="w-full bg-gray-100 rounded-full h-2">
                    <div 
                      class="bg-green-500 h-2 rounded-full transition-all duration-1000"
                      style={`width: ${skill.level}%`}
                    ></div>
                  </div>
                </div>
              ))}
            </div>

          </div>
        ))}
      </div>

      <!-- Soft Skills -->
      <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-2xl p-8 md:p-12">
        <div class="text-center mb-8">
          <h2 class="text-3xl font-bold text-white">Soft Skills</h2>
          <p class="text-gray-300 mt-2">Kemahiran insaniah yang penting dalam kerjaya IT</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {softSkills.map((skill) => (
            <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 text-center border border-white/10 hover:bg-white/20 transition-all">
              <div class="text-3xl mb-2">{skill.icon}</div>
              <div class="text-white text-sm font-medium">{skill.name}</div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>
