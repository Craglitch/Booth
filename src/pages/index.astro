---
import Layout from "../layouts/Layout.astro";
---

<Layout title="IT Career Expo - Home">
  <!-- Hero - Mobile Optimized -->
  <section class="relative overflow-hidden bg-gradient-to-br from-gray-900 via-gray-800 to-green-900 min-h-[70vh] md:min-h-[80vh] flex items-center">
    
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-20 right-10 w-40 md:w-64 h-40 md:h-64 bg-green-400 rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 left-10 w-56 md:w-96 h-56 md:h-96 bg-cyan-400 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20 w-full">
      <div class="max-w-3xl">
        <div class="inline-block bg-green-500/20 backdrop-blur-sm px-3 md:px-4 py-2 rounded-full mb-4 md:mb-6 border border-green-400/30">
          <span class="text-green-300 text-xs md:text-sm font-medium tracking-wider">🚀 IT CAREER EXPO 2026</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-7xl font-bold text-white leading-tight">
          Terokai
          <span class="text-green-400">Kerjaya IT</span>
          Masa Depan Anda
        </h1>

        <p class="mt-4 md:mt-6 text-base md:text-xl text-gray-300 max-w-2xl">
          Dari kod ke cloud, dari data ke security — temui laluan kerjaya dalam dunia teknologi yang semakin berkembang pesat.
        </p>

        <div class="mt-6 md:mt-8 flex flex-col sm:flex-row gap-3 md:gap-4">
          <a href="/career" class="inline-flex items-center justify-center gap-2 bg-green-600 text-white px-6 md:px-8 py-3 md:py-4 rounded-full font-medium hover:bg-green-500 transition-all shadow-lg shadow-green-600/30 text-sm md:text-base">
            💼 Lihat Kerjaya
          </a>
          <a href="/skills" class="inline-flex items-center justify-center gap-2 bg-white/10 backdrop-blur-sm text-white px-6 md:px-8 py-3 md:py-4 rounded-full font-medium hover:bg-white/20 transition-all border border-white/20 text-sm md:text-base">
            ⚡ Lihat Skill
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats - Mobile Optimized -->
  <section class="py-10 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-6">
        
        <div class="text-center p-4 md:p-6 rounded-2xl bg-gray-50 border border-gray-100">
          <div class="text-2xl md:text-4xl font-bold text-green-600">1.5M+</div>
          <div class="text-xs md:text-sm text-gray-600 mt-1 md:mt-2">Peluang Kerjaya IT</div>
        </div>

        <div class="text-center p-4 md:p-6 rounded-2xl bg-gray-50 border border-gray-100">
          <div class="text-2xl md:text-4xl font-bold text-green-600">RM 5K+</div>
          <div class="text-xs md:text-sm text-gray-600 mt-1 md:mt-2">Gaji Permulaan</div>
        </div>

        <div class="text-center p-4 md:p-6 rounded-2xl bg-gray-50 border border-gray-100">
          <div class="text-2xl md:text-4xl font-bold text-green-600">10+</div>
          <div class="text-xs md:text-sm text-gray-600 mt-1 md:mt-2">Bidang Kerjaya</div>
        </div>

        <div class="text-center p-4 md:p-6 rounded-2xl bg-gray-50 border border-gray-100">
          <div class="text-2xl md:text-4xl font-bold text-green-600">95%</div>
          <div class="text-xs md:text-sm text-gray-600 mt-1 md:mt-2">Kadar Pekerjaan</div>
        </div>

      </div>
    </div>
  </section>

  <!-- Purpose - Mobile Optimized -->
  <section class="py-10 md:py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-4xl font-bold text-gray-900">🎯 Tujuan Kami</h2>
        <p class="text-gray-600 mt-2 md:mt-3 max-w-2xl mx-auto text-sm md:text-base">
          Membantu pelajar memahami peluang kerjaya dalam bidang IT
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
        
        <div class="bg-white rounded-2xl p-6 md:p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 hover:-translate-y-2">
          <div class="text-3xl md:text-4xl mb-3 md:mb-4">🎓</div>
          <h3 class="text-lg md:text-xl font-bold text-gray-900">Pendidikan</h3>
          <p class="text-gray-600 mt-2 text-sm md:text-base">Memberi pendedahan kepada pelajar tentang bidang IT yang semakin berkembang.</p>
        </div>

        <div class="bg-white rounded-2xl p-6 md:p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 hover:-translate-y-2">
          <div class="text-3xl md:text-4xl mb-3 md:mb-4">🌐</div>
          <h3 class="text-lg md:text-xl font-bold text-gray-900">Pendedahan</h3>
          <p class="text-gray-600 mt-2 text-sm md:text-base">Menunjukkan pelbagai laluan kerjaya dalam industri teknologi maklumat.</p>
        </div>

        <div class="bg-white rounded-2xl p-6 md:p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 hover:-translate-y-2">
          <div class="text-3xl md:text-4xl mb-3 md:mb-4">🚀</div>
          <h3 class="text-lg md:text-xl font-bold text-gray-900">Inspirasi</h3>
          <p class="text-gray-600 mt-2 text-sm md:text-base">Membakar semangat pelajar untuk menceburi bidang IT pada masa hadapan.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA - Mobile Optimized -->
  <section class="py-10 md:py-16 bg-gradient-to-r from-green-600 to-emerald-600">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-2xl md:text-4xl font-bold text-white">Sedia Untuk Mula?</h2>
      <p class="text-green-100 mt-3 md:mt-4 text-base md:text-lg">Terokai kerjaya IT dan temui potensi anda!</p>
      <a href="/career" class="inline-block mt-6 md:mt-8 bg-white text-green-700 px-6 md:px-8 py-3 md:py-4 rounded-full font-bold hover:bg-gray-100 transition-all shadow-xl text-sm md:text-base">
        Terokai Sekarang →
      </a>
    </div>
  </section>
</Layout>
