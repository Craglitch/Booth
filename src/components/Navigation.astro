---
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
const isCareer = currentPath === '/career';
const isSkills = currentPath === '/skills';
const isAbout = currentPath === '/about';
---

<nav class="bg-white/90 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center gap-2">
          <span class="text-2xl">💻</span>
          <span class="text-gray-900 font-bold text-xl tracking-tight">
            IT<span class="text-green-600">Career</span>
          </span>
        </a>
      </div>

      <!-- Desktop Menu (hidden on mobile) -->
      <div class="hidden md:flex space-x-1">
        <a href="/" class:list={[
          'px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300',
          isHome ? 'bg-green-600 text-white' : 'text-gray-700 hover:bg-gray-100'
        ]}>🏠 Home</a>

        <a href="/career" class:list={[
          'px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300',
          isCareer ? 'bg-green-600 text-white' : 'text-gray-700 hover:bg-gray-100'
        ]}>💼 Career</a>

        <a href="/skills" class:list={[
          'px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300',
          isSkills ? 'bg-green-600 text-white' : 'text-gray-700 hover:bg-gray-100'
        ]}>⚡ Skills</a>

        <a href="/about" class:list={[
          'px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300',
          isAbout ? 'bg-green-600 text-white' : 'text-gray-700 hover:bg-gray-100'
        ]}>ℹ️ About</a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="md:hidden">
        <button id="menu-toggle" class="text-gray-700 hover:text-green-600 focus:outline-none p-2" aria-label="Toggle menu">
          <!-- Hamburger icon -->
          <svg id="menu-open-icon" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <!-- Close icon (hidden by default) -->
          <svg id="menu-close-icon" class="h-6 w-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu (hidden by default) -->
  <div id="mobile-menu" class="md:hidden hidden border-t border-gray-100 bg-white">
    <div class="px-4 py-3 space-y-1">
      <a href="/" class:list={[
        'block px-4 py-3 rounded-lg text-base font-medium transition-all',
        isHome ? 'bg-green-600 text-white' : 'text-gray-700 hover:bg-gray-100'
      ]}>🏠 Home</a>

      <a href="/career" class:list={[
        'block px-4 py-3 rounded-lg text-base font-medium transition-all',
        isCareer ? 'bg-green-600 text-white' : 'text-gray-700 hover:bg-gray-100'
      ]}>💼 Career</a>

      <a href="/skills" class:list={[
        'block px-4 py-3 rounded-lg text-base font-medium transition-all',
        isSkills ? 'bg-green-600 text-white' : 'text-gray-700 hover:bg-gray-100'
      ]}>⚡ Skills</a>

      <a href="/about" class:list={[
        'block px-4 py-3 rounded-lg text-base font-medium transition-all',
        isAbout ? 'bg-green-600 text-white' : 'text-gray-700 hover:bg-gray-100'
      ]}>ℹ️ About</a>
    </div>
  </div>
</nav>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  menuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Close menu when a link is clicked
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>
